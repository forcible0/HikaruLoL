{
  "name": "hikarulol",
  "version": "1.0.0",
  "description": "HikaruLoL - DeepLOL benzeri League of Legends build & tier list masaüstü uygulaması",
  "main": "main.js",
  "author": "HikaruLoL",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron .\"",
    "dev:react": "cross-env BROWSER=none react-scripts start",
    "dev:web": "cross-env BROWSER=none react-scripts start",
    "build:react": "react-scripts build",
    "build": "npm run build:react && electron-builder",
    "build:win": "npm run build:react && electron-builder --win --x64",
    "start": "electron .",
    "electron-dev": "electron ."
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.hikarulol.app",
    "productName": "HikaruLoL",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
